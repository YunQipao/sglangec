# Copy to a private configuration path and edit for the actual 233 installation.
# RS is a CPU/native-verbs service; no GPU process is stopped or selected here.
export REPO=/media/sda1/iic_data/luotao/sglangec/sglang
export CONDA_PREFIX_233=/media/sda1/iic_data/anaconda3/envs/sglang-ec
export RS_HOST=192.168.2.245
export RS_PORT=30700
export RS_TTL=7200
export RS_MAX_STRIPES=32
export RS_MAX_BYTES=8589934592
export RS_RDMA_DEVICE=mlx5_0
export RS_GID_INDEX=3
export RS_RDMA_PORT_BASE=30720
export RS_TIMEOUT=180
# New directory for each manually started RS lifetime. Do not reuse old files.
export RS_RUN_PARENT=/tmp
